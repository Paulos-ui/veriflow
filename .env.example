# =============================================================================
# VeriFlow environment variables
#
# Copy this file to `.env.local` and fill in your OWN values there.
# `.env.local` is gitignored and must NEVER be committed or pasted anywhere.
# All of these are read ONLY on the server (lib/t3n-client.ts, lib/groq.ts).
# =============================================================================

# --- Terminal 3 (server-only) ---
# T3N_API_KEY is the operator's ETH SECRET KEY (0x + 64 hex). The SDK signs the
# handshake with it headlessly: metamask_sign(address, undefined, secretKey).
# T3N_OPERATOR_DID is the did:t3n derived from that key (your enterprise identity).
# Leave T3N_MODE=mock to run a demo-safe simulation with no live node/key.
T3N_API_KEY=
T3N_OPERATOR_DID=
T3N_MODE=mock
T3N_ENV=testnet
# Live execution targets a DEPLOYED Terminal 3 contract. These must resolve to a
# registered script/version that implements the function, or execute() 400s.
T3N_CONTRACT=tee:payments
T3N_CONTRACT_VERSION=1.0.0
T3N_FUNCTION=invoice-pay

# --- Self-custody keystore (server-only) ---
# VERIFLOW_KEK encrypts agent private keys at rest (AES-256-GCM). 32 bytes as
# hex (64 chars) or base64. Generate one: `openssl rand -hex 32`.
# If unset in dev, a deterministic DEV key is used (a warning is logged) — set a
# real KEK before any non-demo use.
VERIFLOW_KEK=

# --- Groq (server-only) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================================================
# The three apps. Each adapter decides LIVE vs FIXTURE/SIMULATED by whether its
# OWN credentials are present, and labels the hop accordingly. Leave a block
# empty and that app runs recorded — the adapter and the mandate gate are
# identical either way, only the network call is skipped.
#
# Note which agent holds what. This split is the product's core claim:
# Ferris (mail.reader) holds Google only, Harbor (comms.poster) holds Slack
# only, Sterling (pay.clerk) holds Stripe only, and Atlas (orchestrator) holds
# nothing at all.
# =============================================================================

# --- Gmail — held by mail.reader ONLY (server-only) ---
# Scope needed: https://www.googleapis.com/auth/gmail.readonly
# The mandate additionally restricts reads to allowlisted senders and labels, so
# a broader OAuth grant does not widen what the agent can actually open.
#
# In Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web application),
# add this EXACT authorised redirect URI for each origin you run on:
#
#     http://localhost:3000/api/gmail/callback
#     https://<your-deployment>.vercel.app/api/gmail/callback
#
# The app derives the redirect from the incoming request's origin, so there is
# no redirect env var to keep in sync — but Google will reject anything not
# registered above.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set these two and the workspace shows "Connect Gmail". Click it, consent, and
# the refresh token is stored SERVER-SIDE only (never sent to the browser).
#
# That store lives on the instance disk, so on Vercel it is lost on a cold
# start. For a connection that survives restarts — which is what you want for a
# judged demo — paste the refresh token here instead. Env always wins.
GOOGLE_REFRESH_TOKEN=
# Optional: skips the refresh exchange if you already hold a live access token.
GOOGLE_ACCESS_TOKEN=
# Optional, cosmetic: the mailbox name shown on the connection row.
GOOGLE_ACCOUNT_EMAIL=

# --- Slack — held by comms.poster ONLY (server-only) ---
# Bot scopes: chat:write, channels:history, reactions:read (the human gate is a
# reaction on the proposal message: ✅ approves, ❌ denies, silence is NOT
# consent — the window closes and the payment is refused).
# Invite the bot to the channel, or chat.postMessage returns not_in_channel.
SLACK_BOT_TOKEN=
# The ONE channel the poster may use. It is injected into the mandate's
# allowlist as well as the call, so these can never drift apart. Leave it empty
# and the demo channel id is used.
SLACK_CHANNEL_ID=

# --- Stripe — held by pay.clerk ONLY (server-only) ---
# Use a TEST-MODE key (sk_test_...). Nothing about the gate changes between test
# and live, which is the point — but there is no reason to move real money to
# prove it. Absent, payments are labelled SIMULATED and never shown as complete.
STRIPE_SECRET_KEY=

# =============================================================================
# Storage
#
# VeriFlow writes three small JSON shelves: cases, agent keys, and the Gmail
# connection. Where they go is resolved in ONE place (lib/storage/root.ts):
#
#   VERIFLOW_DATA_DIR set      → there
#   VERCEL / AWS_LAMBDA_*      → /tmp/veriflow  (the bundle at /var/task is
#                                read-only; writing there is what used to crash
#                                the deployment before hop one)
#   otherwise                  → ./.data
#
# /tmp is per-instance and evaporates on a cold start. That is fine for a demo
# and is reported honestly — the connection row reads state from disk on every
# load, so a lapsed link shows as "not connected" rather than being claimed.
# Point this at a mounted volume for anything that needs to outlive the box.
VERIFLOW_DATA_DIR=
