# =============================================================================
# VeriFlow environment variables
#
# Copy this file to `.env.local` and fill in your OWN values there.
# `.env.local` is gitignored and must NEVER be committed or pasted anywhere.
# All of these are read ONLY on the server (lib/t3n-client.ts, lib/groq.ts).
# =============================================================================

# --- Terminal 3 (server-only) ---
# T3N_API_KEY is the operator's ETH SECRET KEY (0x + 64 hex). The SDK signs the
# handshake with it headlessly: metamask_sign(address, undefined, secretKey).
# T3N_OPERATOR_DID is the did:t3n derived from that key (your enterprise identity).
# Leave T3N_MODE=mock to run a demo-safe simulation with no live node/key.
T3N_API_KEY=
T3N_OPERATOR_DID=
T3N_MODE=mock
T3N_ENV=testnet
# Live execution targets a DEPLOYED Terminal 3 contract. These must resolve to a
# registered script/version that implements the function, or execute() 400s.
T3N_CONTRACT=tee:payments
T3N_CONTRACT_VERSION=1.0.0
T3N_FUNCTION=invoice-pay

# --- Self-custody keystore (server-only) ---
# VERIFLOW_KEK encrypts agent private keys at rest (AES-256-GCM). 32 bytes as
# hex (64 chars) or base64. Generate one: `openssl rand -hex 32`.
# If unset in dev, a deterministic DEV key is used (a warning is logged) — set a
# real KEK before any non-demo use.
VERIFLOW_KEK=

# --- Groq (server-only) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
